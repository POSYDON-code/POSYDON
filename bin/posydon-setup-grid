#!/usr/bin/env python
"""Set up a grid of MESA runs from an ini file.

The work is done by the modules of ``posydon.grids.setup``; this script
reads the command line and calls them in order:

    1. read and check the ini file     config.read_config (new format) or
                                       legacy.read_legacy_config
    2. read the grid points            (CSV, PSyGrid .h5 or a MESA grid folder)
    3. get the scenario's inlists      resolve.resolve_scenario; defaults of a
                                       new-format ini: defaults.fill_defaults
    4. stage sources and compile       extras.stage_extras, compile_executables
    5. write the inlists               build.build_inlists
    6. stage the column lists          extras.stage_column_lists
    7. write the submission scripts    submit.command_line, write_scripts
    8. record what it was set up from  record.write_record (setup_record.ini)

Everything that can fail is checked in steps 1-3, before anything is written
into the run directory.

An ini with a [grid] section is a new-format ini; its [grid] and
[submission] say the mode, run directory and backend, and --grid-type,
--run-directory and --submission-type override them when given. Any other
ini is read as a legacy ini, which needs --grid-type.

Other modes, which write no run directory:

    --list-grid-types           the grid types and what they are
    --init GRID_TYPE            write a starter new-format ini to --inifile
    --explain                   for each inlist, the keys POSYDON or the
                                user set and where each value comes from
"""
##############################################################################
#  IMPORT ALL NECESSARY PYTHON PACKAGES
##############################################################################
import argparse
import configparser
import os
from pathlib import Path

import pandas

from posydon.grids.setup.build import build_inlists
from posydon.grids.setup.config import ConfigError, read_config
from posydon.grids.setup.defaults import fill_defaults
from posydon.grids.setup.explain import explain_text
from posydon.grids.setup.extras import (
    COLUMN_LIST_FILES,
    column_list_sources,
    compile_executables,
    keep_highest_binary_extras,
    merge_extras,
    stage_column_lists,
    stage_extras,
)
from posydon.grids.setup.grid_types import describe_grid_types
from posydon.grids.setup.legacy import read_legacy_config
from posydon.grids.setup.record import write_record
from posydon.grids.setup.resolve import resolve_scenario
from posydon.grids.setup.submit import (
    command_line,
    find_run_grid,
    one_point_per_task,
    write_scripts,
)
from posydon.grids.setup.support import support_root
from posydon.grids.setup.template import ini_template
from posydon.utils.posydonwarning import Pwarn


###############################################################################
# DEFINE COMMANDLINE ARGUMENTS
###############################################################################
def parse_commandline():
    """Parse the arguments given on the command-line.
    """
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--inifile",
                        help="Name of ini file of params")
    parser.add_argument("--grid-type",
                        help="Either you are supplying a grid "
                        "of points to run MESA on (fixed) or you are supplying a pre computed MESA "
                        "grid and want to sample new points to run MESA on (dynamic). "
                        "Needed for a legacy ini; overrides [grid] mode otherwise.")
    parser.add_argument("--run-directory",
                        help="Path where executable will be made and MESA "
                             "simulation output will be placed (default: the "
                             "current directory, or [grid] run_directory)")
    parser.add_argument("--submission-type",
                        help="Options include creating a shell script or a slurm script "
                        "(default: shell, or [submission] backend)")
    parser.add_argument("-n", "--nproc",
                        help="number of processors", type=int, default=1)
    parser.add_argument("--verbose", action="store_true", default=False,
                        help="Run in Verbose Mode")
    parser.add_argument("--list-grid-types", action="store_true",
                        help="List the grid types and exit")
    parser.add_argument("--init", metavar="GRID_TYPE",
                        help="Write a starter ini for GRID_TYPE to --inifile "
                        "and exit")
    parser.add_argument("--explain", action="store_true",
                        help="Show where each inlist value comes from, "
                        "write nothing and exit")

    args = parser.parse_args()

    if args.inifile is None and not args.list_grid_types:
        raise parser.error("--inifile is required")

    if args.grid_type not in [None, 'fixed', 'dynamic']:
        raise parser.error("--grid-type must be either fixed or dynamic")

    if args.submission_type not in [None, 'slurm', 'shell']:
        raise parser.error('--submission-type must be either slurm of shell')

    return args


###############################################################################
# STEPS
###############################################################################
def is_new_format(path):
    """Whether an ini file is in the new format (it has a [grid] section)."""
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.read(path)
    return parser.has_section("grid")


def read_any_config(args):
    """Read the ini in either format, with the command line on top."""
    if not is_new_format(args.inifile):
        if args.grid_type is None:
            raise ValueError("--grid-type is needed for a legacy ini file")
        return read_legacy_config(
            args.inifile, grid_type=args.grid_type,
            submission_type=args.submission_type or 'shell',
            run_directory=args.run_directory or os.getcwd(),
            # grid_params/ paths: from POSYDON-MESA-INLISTS at a pinned
            # commit, since POSYDON no longer ships grid_params/
            support=support_root)
    config = read_config(args.inifile)
    if args.grid_type is not None:
        config.grid.mode = args.grid_type
    if args.run_directory is not None:
        config.grid.run_directory = Path(args.run_directory)
    if args.submission_type == 'shell':
        config.submission.backend = 'shell'
    elif args.submission_type == 'slurm' and \
            config.submission.backend == 'shell':
        config.submission.backend = 'slurm_array' \
            if config.submission.job_array else 'slurm_mpi'
    return config


def check_config(config):
    """Stop on settings that would fail later, before anything is written."""
    grid = config.grid
    if not (grid.points.is_file() or grid.points.is_dir()):
        raise ValueError("Supplied grid does not exist, please check your "
                         "path and try again")
    if grid.mode == "dynamic" and grid.psycris_inifile is None:
        raise ValueError("Please add psycris inifile to the [run_parameters] "
                         "section of the inifile.")
    if grid.mode == "fixed" and not one_point_per_task(config.submission):
        # posydon-run-grid runs a fixed grid one point per call
        # (--grid-point-index); without it nothing would run (tracker S4, R1)
        raise ConfigError("slurm", "job_array",
                          "a fixed grid needs job_array = True")
    if grid.mode == "dynamic" and one_point_per_task(config.submission):
        # posydon-run-grid samples a dynamic grid on rank 0 of one MPI job;
        # a job array cannot run it (tracker S5: it silently ran as fixed)
        raise ConfigError("slurm", "job_array",
                          "a dynamic grid runs as one MPI job: set job_array "
                          "= False (new format: [submission] backend = "
                          "slurm_mpi)")
    if config.scenario.is_set and config.grid.type is None:
        raise ConfigError("mesa_inlists", "scenario",
                          "unknown system type {!r}".format(
                              config.scenario.system_type))
    for note in config.notes:
        # the new ini format is not read by this script yet
        if not note.startswith("legacy ini format"):
            Pwarn(note, "InappropriateValueWarning")


def read_grid_points(grid):
    """The grid points as a DataFrame, and the grid path for MPI runs."""
    path = str(grid.points)
    if '.csv' in path:
        return pandas.read_csv(path), path
    # PSyGrid pulls in matplotlib; only import it when needed (tracker C14)
    from posydon.grids.psygrid import PSyGrid
    if '.h5' in path:
        psy_grid = PSyGrid()
        psy_grid.load(path)
        grid_df = psy_grid.get_pandas_initial_final()
        psy_grid.close()
        return grid_df, path
    if os.path.isdir(path):
        h5_path = os.path.join(os.getcwd(), "fixed_grid_results.h5")
        PSyGrid().create(path, h5_path, slim=True)
        psy_grid = PSyGrid()
        psy_grid.load(h5_path)
        grid_df = psy_grid.get_pandas_initial_final()
        psy_grid.close()
        return grid_df, h5_path
    raise ValueError('Grid format not recognized, please feed in an '
                     'acceptable format: csv')


def grid_parameters(config, grid_df):
    """The names the grid varies: the CSV columns, or psy-cris's."""
    if config.grid.mode == "dynamic":
        from posydon.active_learning.psy_cris.utils import parse_inifile
        psycris = parse_inifile(str(config.grid.psycris_inifile))
        return psycris["posydon_dynamic_sampling_kwargs"]["mesa_column_names"]
    return grid_df.columns


def chosen_extras(config, scenario):
    """The extras of the ini and the scenario, one binary_extras kind."""
    extras = merge_extras(config.extras,
                          scenario.extras if scenario is not None else None)
    kept = keep_highest_binary_extras(extras)
    for key in extras:
        if key not in kept:
            Pwarn("Section mesa_extras value {0} is being set to None"
                  .format(key), "ReplaceValueWarning")
    return kept


###############################################################################
# BEGIN MAIN FUNCTION
###############################################################################
if __name__ == '__main__':
    args = parse_commandline()

    if args.list_grid_types:
        print(describe_grid_types())
        raise SystemExit(0)
    if args.init is not None:
        if os.path.exists(args.inifile):
            raise ValueError("{} exists; not overwriting it".format(
                args.inifile))
        with open(args.inifile, "w") as handle:
            handle.write(ini_template(args.init))
        print("Wrote {}; fill in the <...> values.".format(args.inifile))
        raise SystemExit(0)

    for name in ('MESA_DIR', 'MESASDK_ROOT'):
        if name not in os.environ:
            raise ValueError("{} must be defined in your environment "
                             "before you can set up a grid of MESA runs"
                             .format(name))
    run_grid = find_run_grid()

    # 1-3. read and check everything
    config = read_any_config(args)
    # written into the inlists and scripts as given (legacy: --run-directory)
    run_directory = args.run_directory or str(config.grid.run_directory)
    check_config(config)
    grid_df, mpi_grid = read_grid_points(config.grid)
    if not one_point_per_task(config.submission):
        config.grid.points = Path(mpi_grid)
    resolved = resolve_scenario(config)
    scenario = resolved.files if resolved is not None else None
    fill_defaults(config, resolved, os.environ['MESA_DIR'])
    extras = chosen_extras(config, scenario)
    columns = column_list_sources(config, scenario)
    missing = [name for name in COLUMN_LIST_FILES if name not in columns]
    if missing:
        raise ConfigError("mesa_inlists", None, "no file for the column "
                          "lists {}".format(", ".join(missing)))
    parameters = grid_parameters(config, grid_df)
    if args.explain:
        roots = [resolved.repo] if resolved is not None else []
        print(explain_text(config, scenario, roots))
        raise SystemExit(0)

    # 4-6. write the run directory
    stage_extras(extras, run_directory)
    executables = compile_executables(run_directory)
    inlists = build_inlists(config, run_directory, parameters,
                            scenario=scenario)
    staged_columns = stage_column_lists(columns, run_directory)

    # 7. the scripts that run it, next to the run (tracker S9)
    command = command_line(config, inlists, executables, staged_columns,
                           run_directory, run_grid)
    write_scripts(config, command, len(grid_df), run_directory,
                  os.environ['MESASDK_ROOT'], os.environ['MESA_DIR'])

    # 8. what it was set up from: ini, POSYDON, inlist commit (tracker C13)
    from posydon import __version__ as posydon_version
    write_record(run_directory, config, resolved, args.inifile,
                 os.environ['MESA_DIR'], posydon_version)
