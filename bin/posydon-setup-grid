#!/usr/bin/env python
"""Deprecated wrapper for the posydon grid setup.

Please use 'posydon-grid setup' instead.
"""

import sys

from posydon.CLI.grids import setup
from posydon.utils.posydonwarning import Pwarn


def main() -> None:
    """Run the deprecated grid setup entry point."""
    args = setup.parse_commandline()
    Pwarn(
        "posydon-setup-grid is deprecated, please use 'posydon-grid setup' instead.",
        "DeprecationWarning"
    )
    setup.run_setup(args)


if __name__ == '__main__':  # pragma: no cover
    sys.exit(main())
