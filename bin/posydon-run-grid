#!/usr/bin/env python
"""Deprecated wrapper for the posydon grid run.

Please use 'posydon-grid run' instead.
"""

import sys

from posydon.CLI.grids import run
from posydon.utils.posydonwarning import Pwarn


def main() -> None:
    """Run the deprecated grid run entry point."""
    Pwarn(
        "posydon-run-grid is deprecated, please use 'posydon-grid run' instead.",
        "DeprecationWarning"
    )
    run.main()


if __name__ == '__main__':  # pragma: no cover
    sys.exit(main())
