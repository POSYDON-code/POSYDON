#!/usr/bin/env python
"""POSYDON Spectral Synthesis command line tool.
Mirrors posydon-popsyn executable [4].
"""

__authors__ = [
    "Eirini Kasdagli <kasdaglie@ufl.edu>",
]

import argparse
from posydon.spectral_synthesis.CLI.setup import setup_spectra_function
from posydon.spectral_synthesis.CLI.check import check_spectra_function


if __name__ == '__main__':

    parser = argparse.ArgumentParser(
        prog='posydon-spectra',
        description='POSYDON spectral synthesis command line tool'
    )
    subparsers = parser.add_subparsers(title='subcommands', dest='command')
    subparsers.required = True

    # ── setup subcommand ──────────────────────────────────────────────────
    # mirrors: setup_parser in posydon-popsyn [4]
    setup_parser = subparsers.add_parser(
        'setup',
        help='setup a spectral synthesis run'
    )
    setup_parser.add_argument(
        'ini_file',
        # mirrors: ini_file positional arg in posydon-popsyn [4]
        help='path to the spectral synthesis ini file',
        type=str
    )
    setup_parser.add_argument(
        '-j', '--job_array',
        help='number of batches — mirrors job_array in posydon-popsyn [4]',
        type=int,
        default=10
    )
    # ── SLURM args ────────────────────────────────────────────────────────
    setup_parser.add_argument(
        '--email', help='email for SLURM notifications', default=None
    )
    setup_parser.add_argument(
        '--partition', help='cluster partition to run on', default=None
    )
    setup_parser.add_argument(
        '--walltime', help='walltime per batch job', default='02:00:00'
    )
    setup_parser.add_argument(
        '--merge_walltime', help='walltime for merge job', default='01:00:00'
    )
    setup_parser.add_argument(
        '--mem_per_cpu', help='memory per cpu', default='8G'
    )
    setup_parser.add_argument(
        '--account', help='SLURM account', default=None
    )
    setup_parser.add_argument(
        '--temp_directory',
        help='directory for batch files',
        type=str,
        default='spectra_batches'
    )
    setup_parser.set_defaults(func=setup_spectra_function)

    # ── check subcommand ──────────────────────────────────────────────────
    # mirrors: check_parser in posydon-popsyn [4]
    check_parser = subparsers.add_parser(
        'check',
        help='check the status of a spectral synthesis run '
             'and generate rescue scripts if needed'
    )
    check_parser.add_argument(
        'run_folder',
        help='folder where the spectral synthesis run is located',
        type=str
    )
    check_parser.add_argument(
        '-j', '--job_array', type=int, default=None
    )
    check_parser.add_argument('--email', default=None)
    check_parser.add_argument('--partition', default=None)
    check_parser.add_argument('--walltime', default=None)
    check_parser.add_argument('--merge_walltime', default=None)
    check_parser.add_argument('--mem_per_cpu', default=None)
    check_parser.add_argument('--account', default=None)
    check_parser.set_defaults(func=check_spectra_function)

    args = parser.parse_args()
    args.func(args)